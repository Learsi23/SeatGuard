<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.6887863">
  <!-- Puts the Next.js app in the .NET solution, so Visual Studio shows and starts it.
       npm keeps doing the real work: dotnet build does NOT run npm (see the two flags). -->
  <PropertyGroup>
    <StartupCommand>npm run dev</StartupCommand>
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\.next</BuildOutputFolder>
  </PropertyGroup>
</Project>
